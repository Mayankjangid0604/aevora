# Database
POSTGRES_USER=aevora
POSTGRES_PASSWORD=secret
POSTGRES_DB=aevoradb
DATABASE_URL="postgresql://aevora:secret@localhost:5432/aevoradb?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API & Web
PORT_API=13000
PORT_WEB=3001

# Lead Generation (Phase 42 Step 2) — mock leads unless LEAD_GEN_PROVIDER_ENABLED=true and key set
LEAD_GEN_PROVIDER_ENABLED=false
GOOGLE_PLACES_API_KEY=
LEAD_GEN_CATEGORIES=restaurant,salon,gym,retail_shop,coaching_center
LEAD_GEN_LOCATION=Sikar, Rajasthan, India
LEAD_GEN_RADIUS_M=50000
LEAD_GEN_INTERVAL_HOURS=6

# Sales Outreach (Phase 42 Step 3) — SMTP used when SMTP_HOST set. OUTREACH_ENVIRONMENT=SANDBOX never sends real mail;
# PRODUCTION still redirects to TEST_EMAIL_RECIPIENT unless ENABLE_REAL_PRODUCTION_SENDING=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
OUTREACH_FROM_NAME=AEVORA Team
OUTREACH_ENVIRONMENT=SANDBOX
OUTREACH_FOLLOWUP_DAYS=3
SALES_BATCH_SIZE=5
CHAIRMAN_NAME=Mayank Jangid
COMPANY_NAME=SAAHVIK Tech

# Delivery & Payments (Phase 42 Step 4)
# Base for client sample links: {PUBLIC_API_URL}/delivery/samples/{projectId}
PUBLIC_API_URL=http://localhost:13000
PAYMENT_REMINDER_DAYS=3
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: {PUBLIC_API_URL}/delivery/webhooks/razorpay (event: payment_link.paid)
RAZORPAY_WEBHOOK_SECRET=
BANK_TRANSFER_INSTRUCTIONS=UPI: yourname@upi

# Survival / Financial Kill Switch (Phase 42 Step 5) — defaults for new SurvivalConfig rows
MIN_BALANCE_PAISE=50000
WARNING_BALANCE_PAISE=200000

# Ventures (Phase 42 Step 7)
VENTURE_MAX_TEAM=5

# Autonomous business loop (Phase 42 Step 10) — real-time throttle for survival → lead gen → sales → delivery → payments
BUSINESS_LOOP_INTERVAL_MS=60000

# CEO (Phase 43) — at most one review per simulation hour, and no more often than this many real minutes
CEO_REVIEW_MIN_INTERVAL_MIN=15

# Authentication (REQUIRED)
JWT_SECRET=change-this-to-a-random-32-char-string

# Local Ollama (REQUIRED for AI features)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_COMPLEX_MODEL=phi4:latest

# WhatsApp Business API (optional — without these, WhatsApp messages are pushed to chairman's device)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Claude API (optional — enables tiered model escalation: sonnet/opus/fable)
ANTHROPIC_API_KEY=


# Email sandbox safety net
TEST_EMAIL_RECIPIENT=jangidmayank768@gmail.com
ENABLE_REAL_PRODUCTION_SENDING=false

# Vercel frontend URL (set this after Vercel deploy)
NEXT_PUBLIC_API_URL=http://localhost:13000
NEXT_PUBLIC_WS_URL=http://localhost:13000

# Phase 44 - model tiers & briefs
CEO_MODEL=phi4
CEO_MODEL_COMPLEX=phi4
OLLAMA_MODEL=qwen2.5:7b
COMPANY_PHONE=+919530301131
MODEL_TIER_1=phi4
MODEL_TIER_2=claude-sonnet-5
MODEL_TIER_3=claude-opus-5-5
MODEL_TIER_4=claude-fable-5-1
BUDGET_TIER_1_MAX=500000
BUDGET_TIER_2_MAX=1000000
BUDGET_TIER_3_MAX=2000000
BRIEF_OUTPUT_DIR=briefs/pending
CLAUDE_CODE_ENABLED=true

# Gmail Inbox Reader (Phase 44 Part 7) — reads replies from leads every 10 minutes.
# Step 1: Gmail → Settings → See all settings → Forwarding and POP/IMAP → Enable IMAP → Save
# Step 2: Set INBOX_ENABLED=true
# Step 3: SMTP_USER / SMTP_PASS (Gmail app password) are reused; set IMAP_USER / IMAP_PASS only to override.
INBOX_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Webhook HMAC secrets (REQUIRED - API refuses to start without them)
WEBHOOK_SECRET_PROD=
WEBHOOK_SECRET_SIM=
